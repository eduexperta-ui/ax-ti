# 이 파일을 .env로 복사한 뒤 실제 키를 채웁니다.  cp .env.example .env
# .env는 .gitignore에 포함되어 커밋되지 않습니다.

# 기술 동향 수집 및 리포트 생성 — https://aistudio.google.com/apikey
# 서버에서만 사용되며 프론트엔드 번들에 포함되지 않습니다.
GEMINI_API_KEY=

# 리포트 자동 저장 — https://www.notion.so/my-integrations
NOTION_API_KEY=

# 저장 대상 데이터베이스 ID (Notion DB URL의 32자리 문자열)
# 해당 DB 페이지 우측 상단 ··· → 연결 추가에서 위 Integration을 연결해야 합니다.
NOTION_DATABASE_ID=
